# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-ahmedabad-event-hub-default-secret-key-2026
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ahmedabad_event_hub

# Email Configuration
# By default, emails are printed to the console. To use SMTP, change EMAIL_BACKEND to django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Ahmedabad Event Hub <noreply@ahmedabadeventhub.com>

# JWT Token Settings
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7
